{
  "expo": {
    "name": "Pawanet Planner",
    "slug": "pawanet-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/PNP.png",
    "scheme": "pawanet-planner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "autoIncrement": true,
      "buildNumber": "1",
      "requireFullScreen": true,
      "bundleIdentifier": "com.pawanet.planner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDeviceFamily": [
          1
        ],
        "UIRequiredDeviceCapabilities": [
          "telephony"
        ]
      }
    },
    "android": {
      "package": "com.pawanetplanner.app",
      "icon": "./assets/images/PNP.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/PNP.png",
        "backgroundColor": "#1A0033"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/PNP.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1A0033"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "11a634c8-bce8-4391-b27a-5ec1b9520b42"
      },
      "router": {}
    },
    "owner": "paymb",
    "updates": {
      "url": "https://u.expo.dev/11a634c8-bce8-4391-b27a-5ec1b9520b42"
    }
  }
}
